{
  "manifest_version": 3,
  "name": "Pagixo OCR Scanner",
  "version": "1.0.0",
  "description": "Scan any image or PDF with right-click, drag-drop, or area capture — powered by Pagixo OCR",

  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "dist/background.js"
  },

  "action": {
    "default_popup": "dist/popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "dist/sidepanel/index.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["dist/assets/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "commands": {
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture screen area for OCR"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://localhost:8000 https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com"
  }
}
