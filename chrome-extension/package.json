{
  "name": "pagixo-ocr-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Pagixo OCR Chrome Extension — scan images and PDFs from any webpage",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/build-scripts.mjs",
    "build:ui": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build:all": "vite build && node scripts/build-scripts.mjs && node scripts/validate-extension.js",
    "validate": "node scripts/validate-extension.js",
    "generate:icons": "node scripts/generate-icons.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "marked": "^14.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "dompurify": "^3.1.0"
  },
  "devDependencies": {
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.15",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "esbuild": "^0.24.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  }
}
